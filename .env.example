VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Auth UID for /admin access (Firebase Console → Authentication → Users).
VITE_ADMIN_UID=

# Resend API key for report email alerts (Vercel serverless — server-side only, not exposed to the browser).
# Add this in Vercel project settings → Environment Variables.
RESEND_API_KEY=
RESEND_FROM_EMAIL=KidsRoute <onboarding@resend.dev>
