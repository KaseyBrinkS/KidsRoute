rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function matchDoc(groupId) {
      return get(/databases/$(database)/documents/matches/$(groupId));
    }

    function matchExists(groupId) {
      return exists(/databases/$(database)/documents/matches/$(groupId));
    }

    function matchParticipantIds(groupId) {
      return matchDoc(groupId).data.get('participantIds', []);
    }

    function isMatchParticipant(groupId) {
      return isSignedIn()
        && matchExists(groupId)
        && request.auth.uid in matchParticipantIds(groupId);
    }

    function isInParticipantList(participantIds) {
      return isSignedIn() && request.auth.uid in participantIds;
    }

    function walkGroupDoc(groupId) {
      return get(/databases/$(database)/documents/walkGroups/$(groupId));
    }

    function walkGroupExists(groupId) {
      return exists(/databases/$(database)/documents/walkGroups/$(groupId));
    }

    function walkGroupParticipantIds(groupId) {
      return walkGroupDoc(groupId).data.get('participantIds', []);
    }

    function isWalkGroupParticipant(groupId) {
      return isSignedIn()
        && walkGroupExists(groupId)
        && request.auth.uid in walkGroupParticipantIds(groupId);
    }

    // Walk sessions: create validates against walk group or match; ongoing access uses session participantIds.
    function canCreateWalkSession() {
      let groupId = request.resource.data.groupId;
      return isSignedIn()
        && groupId is string
        && isInParticipantList(request.resource.data.get('participantIds', []))
        && (
          (
            walkGroupExists(groupId)
            && isWalkGroupParticipant(groupId)
          )
          || (
            matchExists(groupId)
            && (
              request.auth.uid in matchParticipantIds(groupId)
              || matchParticipantIds(groupId).size() == 0
              || userHasBuildingWalkSlot(matchDoc(groupId).data)
            )
          )
        );
    }

    function canWriteWalkHistory() {
      return isSignedIn() && request.auth.uid in request.resource.data.get('participantIds', []);
    }

    function canUpdateWalkHistory() {
      return isSignedIn() && (
        request.auth.uid in resource.data.get('participantIds', [])
        || (
          resource.data.groupId is string
          && walkGroupExists(resource.data.groupId)
          && request.auth.uid in walkGroupParticipantIds(resource.data.groupId)
        )
        || (
          resource.data.groupId is string
          && matchExists(resource.data.groupId)
          && request.auth.uid in matchParticipantIds(resource.data.groupId)
        )
      );
    }

    function canAccessWalkSession() {
      return isInParticipantList(resource.data.get('participantIds', []));
    }

    function canAccessWalkSessionChildren(sessionId) {
      let session = get(/databases/$(database)/documents/walkSessions/$(sessionId)).data;
      return isInParticipantList(session.get('participantIds', []));
    }

    function canReadGroupAbsence() {
      return isSignedIn() && request.auth.uid in resource.data.get('participantIds', []);
    }

    function canCreateGroupAbsence() {
      return isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.auth.uid in request.resource.data.get('participantIds', []);
    }

    function buildingWalkSlotPath(walkType, activityId) {
      return activityId == null
        ? /databases/$(database)/documents/buildingWalkSlots/$(request.auth.uid + '_' + walkType)
        : /databases/$(database)/documents/buildingWalkSlots/$(request.auth.uid + '_' + walkType + '_' + activityId);
    }

    function userHasBuildingWalkSlot(matchData) {
      return matchData.matchType == 'building'
        && matchData.buildingWalkType != null
        && exists(buildingWalkSlotPath(matchData.buildingWalkType, matchData.get('activityId', null)));
    }

    function canReadMatch() {
      return isSignedIn() && (
        request.auth.uid in resource.data.get('participantIds', [])
        || userHasBuildingWalkSlot(resource.data)
      );
    }

    function canCreateMatch() {
      return isSignedIn()
        && request.auth.uid in request.resource.data.participantIds;
    }

    function canUpdateMatch() {
      return isSignedIn()
        && request.auth.uid in request.resource.data.participantIds
        && (
          request.auth.uid in resource.data.participantIds
          || userHasBuildingWalkSlot(resource.data)
          || resource.data.get('participantIds', []).size() == 0
        );
    }

    function canDeleteMatch() {
      return isSignedIn() && request.auth.uid in resource.data.participantIds;
    }

    // User profiles, kids, and activities — owner only.
    match /users/{userId} {
      allow read, create, update, delete: if isOwner(userId);

      match /children/{childId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      match /activities/{activityId} {
        allow read, create, update, delete: if isOwner(userId);
      }
    }

    // Activity matching index — readable by all signed-in users; writable by slot owner.
    match /activitySlots/{slotId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    // Activity and building walk groups — participants only.
    match /matches/{matchId} {
      allow read: if canReadMatch();
      allow create: if canCreateMatch();
      allow update: if canUpdateMatch();
      allow delete: if canDeleteMatch();
    }

    // Location + time-window walk groups — readable by signed-in users; writable by members.
    function canCreateWalkGroup() {
      return isSignedIn()
        && request.auth.uid in request.resource.data.get('participantIds', []);
    }

    function canUpdateWalkGroup() {
      return isSignedIn() && (
        request.auth.uid in resource.data.get('participantIds', [])
        || request.auth.uid in request.resource.data.get('participantIds', [])
      );
    }

    match /walkGroups/{groupId} {
      allow read: if isSignedIn();
      allow create: if canCreateWalkGroup();
      allow update: if canUpdateWalkGroup();
      allow delete: if isSignedIn() && request.auth.uid in resource.data.get('participantIds', []);
    }

    // Walk sessions — match participants can create, read, and update.
    match /walkSessions/{sessionId} {
      allow read: if canAccessWalkSession();
      allow create: if canCreateWalkSession();
      allow update: if canAccessWalkSession();
      allow delete: if canAccessWalkSession();

      match /children/{childId} {
        allow read, create, update: if canAccessWalkSessionChildren(sessionId);
        allow delete: if canAccessWalkSessionChildren(sessionId);
      }
    }

    // Absences — parent creates; match participants can read.
    match /groupAbsences/{absenceId} {
      allow read: if canReadGroupAbsence();
      allow create: if canCreateGroupAbsence();
      allow update, delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /walkHistory/{historyId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if canWriteWalkHistory();
      allow update: if canUpdateWalkHistory();
      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    // Building walk opt-in slots — readable by signed-in users; writable by owner.
    match /buildingWalkSlots/{slotId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }
  }
}
