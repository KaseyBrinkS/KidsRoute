rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ── Helpers ──────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isInList(participantIds) {
      return isSignedIn() && request.auth.uid in participantIds;
    }

    function isExternalLeaderAccount() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('accountType', '') == 'external_leader';
    }

    // ── Matches (legacy pairs + building walks) ──────────────────────────────

    function matchDoc(groupId) {
      return get(/databases/$(database)/documents/matches/$(groupId));
    }

    function matchExists(groupId) {
      return exists(/databases/$(database)/documents/matches/$(groupId));
    }

    function matchParticipantIds(groupId) {
      return matchDoc(groupId).data.get('participantIds', []);
    }

    function isMatchParticipant(groupId) {
      return isSignedIn()
        && matchExists(groupId)
        && request.auth.uid in matchParticipantIds(groupId);
    }

    function buildingWalkSlotPath(walkType, activityId) {
      return activityId == null
        ? /databases/$(database)/documents/buildingWalkSlots/$(request.auth.uid + '_' + walkType)
        : /databases/$(database)/documents/buildingWalkSlots/$(request.auth.uid + '_' + walkType + '_' + activityId);
    }

    function userHasBuildingWalkSlot(matchData) {
      return matchData.matchType == 'building'
        && matchData.buildingWalkType != null
        && exists(buildingWalkSlotPath(matchData.buildingWalkType, matchData.get('activityId', null)));
    }

    function canReadMatch() {
      return isSignedIn() && (
        request.auth.uid in resource.data.get('participantIds', [])
        || userHasBuildingWalkSlot(resource.data)
      );
    }

    function canCreateMatch() {
      return isSignedIn()
        && request.auth.uid in request.resource.data.participantIds;
    }

    function canUpdateMatch() {
      return isSignedIn()
        && request.auth.uid in request.resource.data.participantIds
        && (
          request.auth.uid in resource.data.participantIds
          || userHasBuildingWalkSlot(resource.data)
          || resource.data.get('participantIds', []).size() == 0
        );
    }

    function canDeleteMatch() {
      return isSignedIn() && request.auth.uid in resource.data.participantIds;
    }

    // ── Walk groups (activity groups) ────────────────────────────────────────

    function walkGroupDoc(groupId) {
      return get(/databases/$(database)/documents/walkGroups/$(groupId));
    }

    function walkGroupExists(groupId) {
      return exists(/databases/$(database)/documents/walkGroups/$(groupId));
    }

    function walkGroupParticipantIds(groupId) {
      return walkGroupDoc(groupId).data.get('participantIds', []);
    }

    function isWalkGroupParticipant(groupId) {
      return isSignedIn()
        && walkGroupExists(groupId)
        && request.auth.uid in walkGroupParticipantIds(groupId);
    }

    function isWalkGroupLeader(groupId) {
      return isSignedIn()
        && walkGroupExists(groupId)
        && request.auth.uid in walkGroupDoc(groupId).data.get('leaderUserIds', []);
    }

    // Parent accounts can read open groups for matching (location/day queries).
    // External leader accounts only see groups they lead.
    function canReadWalkGroup() {
      return isSignedIn() && (
        !isExternalLeaderAccount()
        || request.auth.uid in resource.data.get('leaderUserIds', [])
      );
    }

    function canCreateWalkGroup() {
      return isSignedIn()
        && request.auth.uid in request.resource.data.get('participantIds', []);
    }

    function canUpdateWalkGroup() {
      return isSignedIn() && (
        request.auth.uid in resource.data.get('participantIds', [])
        || request.auth.uid in request.resource.data.get('participantIds', [])
      );
    }

    // ── Walk sessions ────────────────────────────────────────────────────────

    function canAccessWalkSession() {
      return isInList(resource.data.get('participantIds', []))
        || (
          resource.data.groupId is string
          && walkGroupExists(resource.data.groupId)
          && isWalkGroupLeader(resource.data.groupId)
        );
    }

    function canAccessWalkSessionChildren(sessionId) {
      let session = get(/databases/$(database)/documents/walkSessions/$(sessionId)).data;
      return isInList(session.get('participantIds', []))
        || (
          session.groupId is string
          && walkGroupExists(session.groupId)
          && isWalkGroupLeader(session.groupId)
        );
    }

    function canCreateWalkSession() {
      let groupId = request.resource.data.groupId;
      let sessionParticipants = request.resource.data.get('participantIds', []);
      return isSignedIn()
        && groupId is string
        && isInList(sessionParticipants)
        && (
          (
            walkGroupExists(groupId)
            && (
              isWalkGroupParticipant(groupId)
              || isWalkGroupLeader(groupId)
            )
          )
          || (
            matchExists(groupId)
            && (
              request.auth.uid in matchParticipantIds(groupId)
              || matchParticipantIds(groupId).size() == 0
              || userHasBuildingWalkSlot(matchDoc(groupId).data)
            )
          )
        );
    }

    // ── Absences & walk history ──────────────────────────────────────────────

    function canReadGroupAbsence() {
      return isSignedIn() && (
        request.auth.uid in resource.data.get('participantIds', [])
        || (
          resource.data.groupId is string
          && walkGroupExists(resource.data.groupId)
          && isWalkGroupLeader(resource.data.groupId)
        )
      );
    }

    function canCreateGroupAbsence() {
      return isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.auth.uid in request.resource.data.get('participantIds', []);
    }

    function canWriteWalkHistory() {
      let groupId = request.resource.data.get('groupId', '');
      return isSignedIn() && (
        request.auth.uid in request.resource.data.get('participantIds', [])
        || (groupId is string && walkGroupExists(groupId) && isWalkGroupParticipant(groupId))
        || (groupId is string && walkGroupExists(groupId) && isWalkGroupLeader(groupId))
        || (groupId is string && matchExists(groupId) && request.auth.uid in matchParticipantIds(groupId))
      );
    }

    function canUpdateWalkHistory() {
      let groupId = resource.data.get('groupId', '');
      return isSignedIn() && (
        request.auth.uid in resource.data.get('participantIds', [])
        || resource.data.userId == request.auth.uid
        || (groupId is string && walkGroupExists(groupId) && isWalkGroupParticipant(groupId))
        || (groupId is string && walkGroupExists(groupId) && isWalkGroupLeader(groupId))
        || (groupId is string && matchExists(groupId) && request.auth.uid in matchParticipantIds(groupId))
      );
    }

    function canCreateGroupNotification() {
      return isSignedIn()
        && request.resource.data.groupId is string
        && walkGroupExists(request.resource.data.groupId)
        && request.auth.uid in walkGroupParticipantIds(request.resource.data.groupId);
    }

    // ── Rules ────────────────────────────────────────────────────────────────

    match /users/{userId} {
      allow read, create, update, delete: if isOwner(userId);

      match /children/{childId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      match /activities/{activityId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      match /notifications/{notificationId} {
        allow read, update, delete: if isOwner(userId);
        allow create: if canCreateGroupNotification();
      }
    }

    match /activitySlots/{slotId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /matches/{matchId} {
      allow read: if canReadMatch();
      allow create: if canCreateMatch();
      allow update: if canUpdateMatch();
      allow delete: if canDeleteMatch();
    }

    match /walkGroups/{groupId} {
      allow read: if canReadWalkGroup();
      allow create: if canCreateWalkGroup();
      allow update: if canUpdateWalkGroup();
      allow delete: if isSignedIn()
        && request.auth.uid in resource.data.get('participantIds', []);
    }

    match /leaderInvites/{token} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.groupId is string
        && isWalkGroupParticipant(request.resource.data.groupId);
      allow update: if isSignedIn()
        && resource.data.status == 'pending'
        && request.resource.data.status == 'claimed'
        && request.resource.data.claimedBy == request.auth.uid;
    }

    match /walkSessions/{sessionId} {
      allow read: if canAccessWalkSession();
      allow create: if canCreateWalkSession();
      allow update: if canAccessWalkSession();
      allow delete: if canAccessWalkSession();

      match /children/{childId} {
        allow read, create, update, delete: if canAccessWalkSessionChildren(sessionId);
      }
    }

    match /groupAbsences/{absenceId} {
      allow read: if canReadGroupAbsence();
      allow create: if canCreateGroupAbsence();
      allow update, delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /walkHistory/{historyId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if canWriteWalkHistory();
      allow update: if canUpdateWalkHistory();
      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /buildingWalkSlots/{slotId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }
  }
}
