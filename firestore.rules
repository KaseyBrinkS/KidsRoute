rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.uid == 'DEwa7len6TaBU6mKNceuMlyaRpw1';
    }

    // ── Invite codes ─────────────────────────────────────────────────────────

    match /inviteCodes/{codeId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // ── Private family data (owner only) ─────────────────────────────────────
    // Phone, home address, email, kids, and activities live here.
    // Other families never read these docs — shared contact info is copied
    // onto walkGroups / matches party records when both families approve.

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isAdmin() || (
        isOwner(userId)
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['accountStatus'])
          || (
            resource.data.accountStatus == 'needs_invite'
            && request.resource.data.accountStatus == 'pending'
            && request.resource.data.inviteCodeVerified == true
          )
        )
      );
      allow delete: if isOwner(userId);

      match /children/{childId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      match /activities/{activityId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      match /notifications/{notificationId} {
        allow read, update, delete: if isOwner(userId);
        // Other group members create alerts on your account (e.g. leader approval).
        allow create: if isSignedIn();
      }
    }

    // ── Matching pool (read all, write own) ──────────────────────────────────

    match /activitySlots/{slotId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /buildingWalkSlots/{slotId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    // ── Groups (open to all signed-in users for matching & group actions) ────
    // Party records on these docs hold shared first names + phone only.

    match /walkGroups/{groupId} {
      allow read, write: if isSignedIn();

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/walkGroups/$(groupId)).data.participantIds;
        allow create: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/walkGroups/$(groupId)).data.participantIds
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.displayName is string;
        allow update, delete: if false;
      }
    }

    match /matches/{matchId} {
      allow read, write: if isSignedIn();
    }

    match /leaderInvites/{token} {
      allow read, write: if isSignedIn();
    }

    // ── Walk features (open to all signed-in users) ──────────────────────────

    match /walkSessions/{sessionId} {
      allow read, write: if isSignedIn();

      match /children/{childId} {
        allow read, write: if isSignedIn();
      }
    }

    match /groupAbsences/{absenceId} {
      allow read, write: if isSignedIn();
    }

    match /walkHistory/{historyId} {
      allow read, write: if isSignedIn();
    }
  }
}
